#!/bin/bash
set -euo pipefail

STATE_DIR="${HOME}/.config/herdr/last-tabs"
mkdir -p "$STATE_DIR"

# Get current focused tab and its workspace
current_tab=$(herdr tab list 2>/dev/null | jq -r '.result.tabs[] | select(.focused==true) | .tab_id')
current_ws=$(herdr tab list 2>/dev/null | jq -r '.result.tabs[] | select(.focused==true) | .workspace_id')

if [[ -z "$current_tab" || -z "$current_ws" ]]; then
    exit 1
fi

STATE_FILE="${STATE_DIR}/${current_ws}"

# Read previous tab for this workspace
previous=""
if [[ -f "$STATE_FILE" ]]; then
    previous=$(cat "$STATE_FILE")
fi

# Save current as the new "previous"
echo "$current_tab" > "$STATE_FILE"

# If we have a previous and it's different, jump to it
if [[ -n "$previous" && "$previous" != "$current_tab" ]]; then
    herdr tab focus "$previous" 2>/dev/null
fi
