#!/bin/bash
# Clone a GitLab MR into the reviews dir over HTTPS and generate check-diff.sh for plannotator review.

set -eou pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CONFIG_FILE="${GLAB_REVIEW_CHECKOUT_CONFIG:-${SCRIPT_DIR}/glab-review-checkout-config.jsonl}"

# Read at runtime by git; the token itself is never written to .git/config or the remote URL.
# shellcheck disable=SC2016
CRED_HELPER='!f() { echo username=oauth2; echo "password=$GITLAB_PAT"; }; f'

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") <mr-url> [options]

Clone (or reuse) a GitLab repo under the reviews dir over HTTPS, fetch the MR head,
and print the MR's commits. Writes check-diff.sh into the clone and prints the clone
path on stdout so you can cd into it and run ./check-diff.sh.

Works for open and merged MRs: the head and base commits are fetched by SHA from the
MR API, because GitLab only keeps refs/merge-requests/<n>/head for open MRs.

Arguments:
  mr-url               https://HOST/GROUP/PROJECT/-/merge_requests/N

Options:
  --reviews-dir DIR    Where clones live (default: "reviews_dir" from the config file)
  -h, --help           Show this help message

Config: ${CONFIG_FILE}
  JSON Lines; the first non-empty line is used. Keys:
    "host"         GitLab host the token is allowed for; other hosts are refused
    "reviews_dir"  where clones live (a leading ~ is expanded)
  Not checked in. Copy glab-review-checkout-config.jsonl.example next to this script and edit it.
  Override the path with GLAB_REVIEW_CHECKOUT_CONFIG.

Auth:
  GITLAB_PAT must be exported. It is used for the API (GITLAB_TOKEN) and for git
  over HTTPS (username oauth2) through a per-clone credential helper.

Examples:
  $(basename "$0") https://gitlab.example.com/group/project/-/merge_requests/42
  cd "\$($(basename "$0") <mr-url>)" && ./check-diff.sh
EOF
}

check_prereqs() {
  local missing=()
  for cmd in glab git jq; do
    if ! command -v "$cmd" &>/dev/null; then
      missing+=("$cmd")
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Missing required commands: ${missing[*]}" >&2
    exit 1
  fi
  if [[ -z "${GITLAB_PAT:-}" ]]; then
    echo "GITLAB_PAT is empty; export it and retry" >&2
    exit 1
  fi
}

log() {
  echo "$*" >&2
}

# Print one key from the first non-empty line of the config file.
read_config() {
  local key="$1"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Config not found: ${CONFIG_FILE}" >&2
    echo "Copy ${CONFIG_FILE}.example to that path and edit it." >&2
    exit 1
  fi
  local value
  value="$(grep -m1 -v '^[[:space:]]*$' "$CONFIG_FILE" | jq -r --arg k "$key" '.[$k] // empty')"
  if [[ -z "$value" ]]; then
    echo "No \"${key}\" in the first line of ${CONFIG_FILE}" >&2
    exit 1
  fi
  echo "${value/#\~/$HOME}"
}

# Write check-diff.sh into the clone so the review commands need no copy-paste.
write_check_diff() {
  local dir="$1" project="$2" mr="$3" base_sha="$4"
  local out="${dir}/check-diff.sh"

  {
    echo '#!/bin/bash'
    echo "# Review ${project} MR ${mr} in plannotator. Generated by glab-mr-review-checkout."
    echo
    echo 'set -eou pipefail'
    echo
    printf 'BASE=%s\n' "$base_sha"
    printf 'MR=%s\n' "$mr"
    cat <<'EOF'

usage() {
  cat >&2 <<USAGE
Usage: $(basename "$0") [N | -l]

Open this MR's diff in plannotator-tui-hc-review. Run it inside herdr-core.

  (no args)    whole MR: everything since the fork point (${BASE})
  N            only the Nth commit, oldest first (see -l)
  -l, --list   list the MR's commits with their numbers
  -h, --help   show this help message
USAGE
}

main() {
  cd "$(dirname "$0")"
  case "${1:-}" in
    -h | --help)
      usage
      ;;
    -l | --list)
      git log --reverse --format='%h %s' "${BASE}..HEAD" | nl -w2 -s'  '
      ;;
    "")
      exec plannotator-tui-hc-review --base "$BASE"
      ;;
    *[!0-9]*)
      usage
      exit 1
      ;;
    *)
      local sha
      sha="$(git rev-list --reverse "${BASE}..HEAD" | sed -n "${1}p")"
      if [[ -z "$sha" ]]; then
        echo "No commit number $1 in MR ${MR}; see --list" >&2
        exit 1
      fi
      exec plannotator-tui-hc-review --commit "$sha"
      ;;
  esac
}

main "$@"
EOF
  } >"$out"
  chmod +x "$out"

  # Keep the generated file out of git status in the clone.
  local exclude
  exclude="$(git -C "$dir" rev-parse --git-path info/exclude)"
  mkdir -p "$(dirname "${dir}/${exclude}")"
  grep -qxF 'check-diff.sh' "${dir}/${exclude}" 2>/dev/null || echo 'check-diff.sh' >>"${dir}/${exclude}"
}

main() {
  local target="" reviews_dir=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      --reviews-dir)
        reviews_dir="${2:?--reviews-dir needs a directory}"
        shift 2
        ;;
      -*)
        echo "Unknown option: $1" >&2
        usage
        exit 1
        ;;
      *)
        target="$1"
        shift
        ;;
    esac
  done

  : "${target:?MR url is required (see --help)}"
  check_prereqs

  local host project mr
  if [[ "$target" =~ ^https?://([^/]+)/(.+)/-/merge_requests/([0-9]+) ]]; then
    host="${BASH_REMATCH[1]}"
    project="${BASH_REMATCH[2]}"
    mr="${BASH_REMATCH[3]}"
  else
    echo "Cannot parse MR URL: ${target}" >&2
    exit 1
  fi

  # Never send the token to a host other than the configured one.
  local allowed_host
  allowed_host="$(read_config host)"
  if [[ "$host" != "$allowed_host" ]]; then
    echo "Host ${host} is not the configured host ${allowed_host}; refusing to use the token" >&2
    exit 1
  fi

  if [[ -z "$reviews_dir" ]]; then
    reviews_dir="$(read_config reviews_dir)"
  fi

  local encoded api_json
  encoded="$(jq -rn --arg p "$project" '$p | @uri')"
  api_json="$(GITLAB_HOST="$host" GITLAB_TOKEN="$GITLAB_PAT" \
    glab api "projects/${encoded}/merge_requests/${mr}")"

  local state source target_branch head_sha base_sha
  state="$(jq -r .state <<<"$api_json")"
  source="$(jq -r .source_branch <<<"$api_json")"
  target_branch="$(jq -r .target_branch <<<"$api_json")"
  head_sha="$(jq -r .diff_refs.head_sha <<<"$api_json")"
  base_sha="$(jq -r .diff_refs.base_sha <<<"$api_json")"

  if [[ "$head_sha" == "null" || "$base_sha" == "null" ]]; then
    echo "MR ${mr} has no diff_refs yet; nothing to review" >&2
    exit 1
  fi

  local url="https://${host}/${project}.git"
  local dir="${reviews_dir}/mr-${mr}-${project##*/}"

  mkdir -p "$reviews_dir"
  if [[ -d "${dir}/.git" ]]; then
    log "action=reuse dir=${dir}"
    git -C "$dir" remote set-url origin "$url"
  else
    log "action=clone project=${project} dir=${dir}"
    GIT_TERMINAL_PROMPT=0 git -c credential.helper= -c credential.helper="$CRED_HELPER" \
      clone --no-checkout "$url" "$dir" >&2
  fi

  cd "$dir"
  export GIT_TERMINAL_PROMPT=0

  # Empty value first so the global osxkeychain helper does not answer before ours.
  git config --replace-all credential.helper ''
  git config --add credential.helper "$CRED_HELPER"

  git fetch origin "$target_branch" >&2

  log "action=fetch head=${head_sha}"
  if ! git fetch origin "$head_sha" >&2; then
    log "action=fetch-fallback ref=refs/merge-requests/${mr}/head"
    git fetch origin "refs/merge-requests/${mr}/head" >&2
  fi
  git checkout -q -B "mr-${mr}" "$head_sha" >&2

  # Fork point of the MR, so the diff stays fixed however far the target branch moves.
  local merge_base
  if ! merge_base="$(git merge-base "$base_sha" HEAD 2>/dev/null)"; then
    merge_base="$base_sha"
  fi

  log "state=${state} source=${source} target=${target_branch} head_sha=${head_sha} base_sha=${merge_base}"
  log ""
  log "Commits (oldest first):"
  git log --reverse --format='  %h %s' "${merge_base}..HEAD" >&2
  log ""

  write_check_diff "$dir" "$project" "$mr" "$merge_base"
  log "Next, from ${dir}:"
  log "  ./check-diff.sh        # whole MR"
  log "  ./check-diff.sh -l     # list commits with numbers"
  log "  ./check-diff.sh 3      # only commit number 3"

  echo "$dir"
}

main "$@"
