#!/usr/bin/env bash
set -euo pipefail

# Check if current branch needs a rebase against a target branch

TARGET="${1:-main}"
CURRENT=$(git branch --show-current)

if [[ -z "$CURRENT" ]]; then
  echo "ERROR: not on a branch (detached HEAD?)" >&2
  exit 1
fi

if [[ "$CURRENT" == "$TARGET" ]]; then
  echo "ERROR: already on $TARGET" >&2
  exit 1
fi

git fetch origin "$TARGET" --quiet 2>/dev/null || true

BEHIND=$(git log --oneline "$CURRENT..origin/$TARGET" | wc -l | tr -d ' ')
AHEAD=$(git log --oneline "origin/$TARGET..$CURRENT" | wc -l | tr -d ' ')

echo "branch=$CURRENT target=origin/$TARGET ahead=$AHEAD behind=$BEHIND"

if [[ "$BEHIND" -eq 0 ]]; then
  echo "status=up-to-date rebase_required=no"
else
  echo "status=diverged rebase_required=yes"
  echo ""
  echo "Commits on origin/$TARGET not in $CURRENT:"
  git log --oneline "$CURRENT..origin/$TARGET"
fi
