#!/bin/bash
# Clone a GitHub repo into the reviews dir, check out a PR, and list its commits for plannotator review.

set -eou pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CONFIG_FILE="${GH_REVIEW_CHECKOUT_CONFIG:-${SCRIPT_DIR}/gh-review-checkout-config.jsonl}"
DEFAULT_USER="saurabh-hirani"

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") <pr-url | pr-number> [options]

Clone (or reuse) a GitHub repo under the reviews dir over HTTPS, check out the PR head (works for open and merged PRs),
and print the PR's commits. Prints the clone path on stdout so you can cd into it
and run plannotator-tui-hc-review there.

Arguments:
  pr-url | pr-number   PR URL (https://github.com/OWNER/REPO/pull/N) or a bare number

Options:
  --repo OWNER/REPO    Repository; required when a bare PR number is given
  --reviews-dir DIR    Where clones live (default: "reviews_dir" from the config file)
  --user NAME          GitHub username put in the remote URL (default: ${DEFAULT_USER})
  -h, --help           Show this help message

Config: ${CONFIG_FILE}
  JSON Lines; the first non-empty line is used. Key: "reviews_dir" (a leading ~ is expanded).
  Not checked in. Copy gh-review-checkout-config.jsonl.example next to this script and edit it.
  Override the path with GH_REVIEW_CHECKOUT_CONFIG.

Why HTTPS: ~/.gitconfig rewrites https://github.com/ to SSH, which fails when port 22 is
blocked. The username in the remote URL skips the rewrite, and 'gh' supplies credentials.
See misc/learn-git/https-push.md.

Examples:
  $(basename "$0") https://github.com/one2nc/langfuse-workshop/pull/2
  $(basename "$0") 2 --repo one2nc/langfuse-workshop
  cd "\$($(basename "$0") 2 --repo one2nc/langfuse-workshop)"
EOF
}

check_prereqs() {
  local missing=()
  for cmd in gh git jq; do
    if ! command -v "$cmd" &>/dev/null; then
      missing+=("$cmd")
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Missing required commands: ${missing[*]}" >&2
    exit 1
  fi
  if ! gh auth status &>/dev/null; then
    echo "gh is not logged in; run: gh auth login" >&2
    exit 1
  fi
}

# Print reviews_dir from the first non-empty line of the config file.
read_reviews_dir() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Config not found: ${CONFIG_FILE}" >&2
    echo "Copy ${CONFIG_FILE}.example to that path and edit it, or pass --reviews-dir." >&2
    exit 1
  fi
  local value
  value="$(grep -m1 -v '^[[:space:]]*$' "$CONFIG_FILE" | jq -r '.reviews_dir // empty')"
  if [[ -z "$value" ]]; then
    echo "No \"reviews_dir\" in the first line of ${CONFIG_FILE}" >&2
    exit 1
  fi
  echo "${value/#\~/$HOME}"
}

log() {
  echo "$*" >&2
}

# Sets REPO and PR from a PR URL.
parse_url() {
  local url="$1"
  if [[ "$url" =~ ^https?://github\.com/([^/]+/[^/]+)/pulls?/([0-9]+) ]]; then
    REPO="${BASH_REMATCH[1]}"
    PR="${BASH_REMATCH[2]}"
  else
    echo "Cannot parse PR URL: ${url}" >&2
    exit 1
  fi
}

# Write check-diff.sh into the clone so the review commands need no copy-paste.
write_check_diff() {
  local dir="$1" repo="$2" pr="$3" base_sha="$4"
  local out="${dir}/check-diff.sh"

  {
    echo '#!/bin/bash'
    echo "# Review ${repo} PR ${pr} in plannotator. Generated by gh-pr-review-checkout."
    echo
    echo 'set -eou pipefail'
    echo
    printf 'BASE=%s\n' "$base_sha"
    printf 'PR=%s\n' "$pr"
    cat <<'EOF'

usage() {
  cat >&2 <<USAGE
Usage: $(basename "$0") [N | -l]

Open this PR's diff in plannotator-tui-hc-review. Run it inside herdr-core.

  (no args)    whole PR: everything since the fork point (${BASE})
  N            only the Nth commit, oldest first (see -l)
  -l, --list   list the PR's commits with their numbers
  -h, --help   show this help message
USAGE
}

main() {
  cd "$(dirname "$0")"
  case "${1:-}" in
    -h | --help)
      usage
      ;;
    -l | --list)
      git log --reverse --format='%h %s' "${BASE}..HEAD" | nl -w2 -s'  '
      ;;
    "")
      exec plannotator-tui-hc-review --base "$BASE"
      ;;
    *[!0-9]*)
      usage
      exit 1
      ;;
    *)
      local sha
      sha="$(git rev-list --reverse "${BASE}..HEAD" | sed -n "${1}p")"
      if [[ -z "$sha" ]]; then
        echo "No commit number $1 in PR ${PR}; see --list" >&2
        exit 1
      fi
      exec plannotator-tui-hc-review --commit "$sha"
      ;;
  esac
}

main "$@"
EOF
  } >"$out"
  chmod +x "$out"

  # Keep the generated file out of git status in the clone.
  local exclude
  exclude="$(git -C "$dir" rev-parse --git-path info/exclude)"
  mkdir -p "$(dirname "${dir}/${exclude}")"
  grep -qxF 'check-diff.sh' "${dir}/${exclude}" 2>/dev/null || echo 'check-diff.sh' >>"${dir}/${exclude}"
}

main() {
  local target="" reviews_dir="" user="$DEFAULT_USER"
  REPO=""
  PR=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      --repo)
        REPO="${2:?--repo needs OWNER/REPO}"
        shift 2
        ;;
      --reviews-dir)
        reviews_dir="${2:?--reviews-dir needs a directory}"
        shift 2
        ;;
      --user)
        user="${2:?--user needs a GitHub username}"
        shift 2
        ;;
      -*)
        echo "Unknown option: $1" >&2
        usage
        exit 1
        ;;
      *)
        target="$1"
        shift
        ;;
    esac
  done

  : "${target:?PR url or number is required (see --help)}"
  check_prereqs

  if [[ -z "$reviews_dir" ]]; then
    reviews_dir="$(read_reviews_dir)"
  fi

  if [[ "$target" =~ ^[0-9]+$ ]]; then
    PR="$target"
    : "${REPO:?--repo OWNER/REPO is required with a bare PR number}"
  else
    parse_url "$target"
  fi

  local name="${REPO##*/}"
  local dir="${reviews_dir}/pr-${PR}-${name}"

  local url="https://${user}@github.com/${REPO}.git"

  mkdir -p "$reviews_dir"
  if [[ -d "${dir}/.git" ]]; then
    log "action=reuse dir=${dir}"
  else
    log "action=clone repo=${REPO} dir=${dir}"
    git clone "$url" "$dir" >&2
  fi

  cd "$dir"

  # Idempotent: also repairs clones made earlier with an SSH origin.
  git remote set-url origin "$url"
  git config credential.helper '!gh auth git-credential'

  # Forks get an "upstream" remote, and gh may resolve PR numbers against it.
  gh repo set-default "$REPO" >&2

  # refs/pull/N/head survives merge and branch deletion, unlike the PR's source branch.
  log "action=fetch ref=refs/pull/${PR}/head"
  git fetch origin "refs/pull/${PR}/head" >&2
  git checkout -q -B "pr-${PR}" FETCH_HEAD >&2

  local state base base_oid
  state="$(gh pr view "$PR" -R "$REPO" --json state --jq .state)"
  base="$(gh pr view "$PR" -R "$REPO" --json baseRefName --jq .baseRefName)"
  base_oid="$(gh pr view "$PR" -R "$REPO" --json baseRefOid --jq .baseRefOid)"
  git fetch origin "$base" >&2

  # Fork point of the PR branch, so the diff stays fixed however far the base branch moves.
  local merge_base
  merge_base="$(git merge-base "$base_oid" HEAD)"

  log "state=${state} branch=pr-${PR} base_branch=${base} base_sha=${merge_base}"
  log ""
  log "Commits (oldest first):"
  git log --reverse --format='  %h %s' "${merge_base}..HEAD" >&2
  log ""
  write_check_diff "$dir" "$REPO" "$PR" "$merge_base"
  log "Next, from ${dir}:"
  log "  ./check-diff.sh        # whole PR"
  log "  ./check-diff.sh -l     # list commits with numbers"
  log "  ./check-diff.sh 3      # only commit number 3"

  echo "$dir"
}

main "$@"
